# Copy to .env and adjust. Every value has a working default; the ones shown here are
# the defaults from core/config.py unless a comment says otherwise.
#
# Do not quote values: `make` reads this file with its own parser, which keeps quotes
# as part of the value.
#
# The *_BASE_URL variables are deliberately absent: containers get them from
# docker-compose.yml, and host-side tools fall back to localhost defaults.

QDRANT_COLLECTION=docsrag

INFERENCE_BACKEND=ollama
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# 14B rather than the 7B default: it is the only MLX 4-bit Qwen2.5 that produces clean
# Cyrillic in the EN->RU step. Slower, and irrelevant unless INFERENCE_BACKEND=vllm.
VLLM_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# pytorch | onnx-fp32 | onnx-int8. The ONNX backends need `make install-onnx` and
# `make export-onnx` first; onnx-int8 reads its own collection.
EMBEDDER_BACKEND=pytorch

# dense | hybrid | hybrid_rerank — dense wins on this corpus, see README.
RETRIEVAL_STRATEGY=dense

CHUNK_SIZE=1024
CHUNK_OVERLAP=100
DOCS_SOURCE_PATH=data/raw/fastapi/docs/en/docs

MLFLOW_PORT=5555
MLFLOW_TRACKING_URI=http://localhost:5555

# Optional: bge-small is public. Only needed for gated or rate-limited models.
HF_TOKEN=

# Empty keys disable tracing. Keys are verified at startup, so wrong ones produce a
# single warning rather than a 401 per request.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

GRAFANA_ADMIN_PASSWORD=admin

# Empty disables authentication on /ask and /agent/ask. When set, send it as X-API-Key.
API_KEY=
