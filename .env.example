# Copy to .env and adjust as needed.
# All values shown are defaults from api/config.py.

# QDRANT_URL is intentionally not set here:
# - Docker container gets http://qdrant:6333 from docker-compose.yml
# - Local tools (eval, indexing) use the default http://localhost:6333 from config.py
QDRANT_COLLECTION=docsrag

INFERENCE_BACKEND=ollama

# OLLAMA_BASE_URL is intentionally not set here:
# - Docker container gets http://host.docker.internal:11434 from docker-compose.yml
# - Local tools (eval, indexing) use the default http://localhost:11434 from config.py
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# VLLM_BASE_URL is intentionally not set here:
# - Docker container gets http://host.docker.internal:8001/v1 from docker-compose.yml
# - Local tools (eval) use the default http://localhost:8001/v1 from config.py
# VLLM_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
VLLM_MODEL=mlx-community/Qwen2.5-14B-Instruct-4bit

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

EMBEDDING_DIM=384

# Embedder backend — selects runtime via embeddings.factory.make_embedder():
#   pytorch    : sentence-transformers, MPS/CUDA/CPU. Default.
#   onnx-fp32  : ONNX Runtime FP32, byte-equivalent to pytorch (parity-gated). Reads docsrag.
#   onnx-int8  : ONNX Runtime + dynamic per-channel INT8. ~4x smaller. Reads docsrag_int8.
# ONNX backends require `make install-onnx` + `make export-onnx` (+ `make quantize-onnx` for int8).
# Note: TorchScript is NOT a runtime option here — it's a bench-only artifact (see
# benchmarks/bench_embedder.py), not wired through make_embedder() by design. Pydantic
# will reject any other value (e.g. EMBEDDER_BACKEND=torchscript) with a ValidationError.
EMBEDDER_BACKEND=pytorch
# EMBEDDER_ONNX_FP32_PATH=models/bge-small-en-v1.5-onnx-fp32
# EMBEDDER_ONNX_INT8_PATH=models/bge-small-en-v1.5-onnx-int8
# QDRANT_COLLECTION_INT8=docsrag_int8

CHUNK_SIZE=1024
CHUNK_OVERLAP=100

DOCS_SOURCE_PATH=data/raw/fastapi/docs/en/docs

# Hugging Face token — required to download the embedding model on first run.
# Get one at: https://huggingface.co/settings/tokens (read-only scope is enough).
HF_TOKEN=hf_xxx_replace_me

# LangFuse tracing (optional — leave empty to disable).
# WARNING: if you set these with stale/wrong-project/wrong-region keys, every
# /ask request emits a noisy `Failed to export span batch code: 401` line.
# Either fix the keys (cloud.langfuse.com → Settings → API Keys; check region —
# US-cloud and EU-cloud have different keypairs) or just leave both empty.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
